# MCP Conductor Environment Variables
# Copy this file to .env and customize for your setup

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Configuration
CONFIG_PATH=./config/conductor.yaml
DATA_DIR=./data

# Web Interface
WEB_PORT=3000
WEB_HOST=localhost

# Security
# Generate a secure 32+ character key for production
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Optional: Database connection (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_conductor

# Optional: Redis connection (for future use)
# REDIS_URL=redis://localhost:6379

